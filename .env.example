# === Base de datos (Neon) — server-side only, NUNCA en el bundle del cliente ===
# Connection string POOLED de Neon. Cargar el valor real en .env.local (gitignored)
# y en Vercel → Settings → Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# === Neon Auth (Stack) — se completan al habilitar Neon Auth en el proyecto ===
# Las claves públicas pueden ir al cliente; la secreta SOLO server-side.
NEXT_PUBLIC_STACK_PROJECT_ID="..."
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="..."
STACK_SECRET_SERVER_KEY="..."

# ENCRYPTION_KEY: clave de 32 bytes (256 bits) para cifrar campos fiscales/bancarios
# (CUIT, CBU). Generar con: openssl rand -base64 32   — SOLO server-side, nunca en el cliente.
ENCRYPTION_KEY="..."

# APP_URL: URL pública donde se hostea (para enlaces, callbacks de auth, etc.)
APP_URL="https://terabound.com"
